# Agenda Base — valores de referência da instalação. NÃO coloque segredos aqui.
#
# O aplicativo é um site estático: estes valores vão para public/config.js (ver docs/INSTALACAO.md).
# Eles identificam o projeto Firebase e ficam visíveis no navegador de qualquer visitante;
# a proteção dos dados é feita por firestore.rules.
#
# Segredos (senha da proprietária, chave secreta do reCAPTCHA, token da API do WhatsApp, chaves de
# conta de serviço) NUNCA entram no repositório: ficam no console do Firebase/Google Cloud.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=seu-projeto.firebaseapp.com
FIREBASE_PROJECT_ID=seu-projeto
FIREBASE_APP_ID=

# Opcional: chave PÚBLICA do site reCAPTCHA v3 para o App Check
APP_CHECK_SITE_KEY=

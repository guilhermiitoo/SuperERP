{
  "name": "agenda-base",
  "version": "0.1.0",
  "private": true,
  "description": "Sistema de agendamento para profissionais autônomos (manicure, barbearia, estética). Uma instalação por negócio.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "vendor": "node scripts/build-vendor.mjs",
    "test": "npm run test:unit && npm run test:rules && npm run test:e2e",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:rules": "firebase emulators:exec --only firestore,auth --project demo-agenda \"node --test --test-concurrency=1 tests/rules/*.test.mjs\"",
    "test:e2e": "node --test --test-concurrency=1 \"tests/e2e/*.test.mjs\"",
    "test:e2e:firebase": "firebase emulators:exec --only firestore,auth --project demo-agenda \"node --test --test-concurrency=1 tests/e2e-firebase/*.test.mjs\"",
    "emulators": "firebase emulators:start --only firestore,auth --project demo-agenda",
    "deploy": "firebase deploy --only hosting,firestore:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "esbuild": "^0.25.0",
    "firebase": "^12.0.0",
    "firebase-tools": "^14.0.0",
    "playwright": "1.63.0"
  }
}
